    //========================================================================
    // Canonical CPU cycle trace
    //
    // Enable with: +BRS_TRACE=<output-path>
    // Sampling is in the posedge active region, before nonblocking updates.
    // This is the same value set sampled by the DONE monitor and downstream
    // sequential logic on that edge. Edge 1 is the first rising edge;
    // edges 1..100 are reset and the first active CPU cycle is edge 101.
    //========================================================================
    integer brs_trace_fd;
    integer brs_trace_edge;
    integer brs_trace_cpu_cycle;
    logic   brs_trace_enable;
    string  brs_trace_path;

    wire brs_done_now = reset_n && dbus_out_req &&
        dbus_out_addr == DONE_ADDR && dbus_out_wstrb == 4'hf &&
        (dbus_out_wdata == 32'd2 || dbus_out_wdata == 32'd4);
    wire brs_wb_we = cpu_i._icu_i_update_gpr_we &&
        (|cpu_i._icu_i_update_gpr_waddr);

    initial begin
        brs_trace_fd = 0;
        brs_trace_edge = 0;
        brs_trace_cpu_cycle = 0;
        brs_trace_enable = 1'b0;
        brs_trace_path = "";
        if (!$value$plusargs("BRS_TRACE=%s", brs_trace_path) &&
            $test$plusargs("BRS_TRACE"))
            brs_trace_path = "rtl_cycle_trace.log";
        if (brs_trace_path != "") begin
            brs_trace_fd = $fopen(brs_trace_path, "w");
            if (brs_trace_fd == 0) begin
                $fatal(1, "Unable to open BRS cycle trace: %s", brs_trace_path);
            end
            brs_trace_enable = 1'b1;
            $fwrite(brs_trace_fd,
                "# brs-cycle-trace-v1 source=rtl sampling=posedge-pre-nba reset_edges=100\n");
            $fflush(brs_trace_fd);
        end
    end

    always @(posedge clk) begin
        brs_trace_edge = brs_trace_edge + 1;
        if (!reset_n)
            brs_trace_cpu_cycle = 0;
        else
            brs_trace_cpu_cycle = brs_trace_cpu_cycle + 1;

        if (brs_trace_enable) begin
            $fwrite(brs_trace_fd,
                "edge=%0d reset=%0d cpu_cycle=%0d ",
                brs_trace_edge, !reset_n, brs_trace_cpu_cycle);
            $fwrite(brs_trace_fd,
                "ibus_req=%0d ibus_addr=0x%08h ibus_re=%0d ",
                ibus_out_req, ibus_out_addr, ibus_out_req);
            $fwrite(brs_trace_fd,
                "ibus_resp=%0d ibus_r0=0x%08h ibus_r1=0x%08h ibus_r2=0x%08h ibus_r3=0x%08h ",
                ibus_in_resp, ibus_in_rdata_0, ibus_in_rdata_1,
                ibus_in_rdata_2, ibus_in_rdata_3);
            $fwrite(brs_trace_fd,
                "dbus_req=%0d dbus_addr=0x%08h dbus_re=%0d dbus_we=%0d ",
                dbus_out_req, dbus_out_addr,
                dbus_out_req && !(|dbus_out_wstrb),
                dbus_out_req && (|dbus_out_wstrb));
            $fwrite(brs_trace_fd,
                "dbus_wstrb=0x%01h dbus_wdata=0x%08h ",
                dbus_out_wstrb, dbus_out_wdata);
            $fwrite(brs_trace_fd,
                "dbus_resp=%0d dbus_rdata=0x%08h grant=%0d ",
                dbus_in_resp, dbus_in_rdata, crossbar_i.grant_master
            );
            $fwrite(brs_trace_fd,
                "retire=%0d retire_pc=0x%08h retire_instr=0x%08h ",
                trace_bus_retire_instr_valid,
                trace_bus_retire_pc_bits, trace_bus_retire_instr_bits);
            $fwrite(brs_trace_fd,
                "wb_we=%0d wb_fp=%0d wb_rd=%0d wb_data=0x%08h ",
                brs_wb_we,
                brs_wb_we && cpu_i._icu_i_update_gpr_waddr[5],
                brs_wb_we ? cpu_i._icu_i_update_gpr_waddr[4:0] : 5'd0,
                brs_wb_we ? cpu_i._icu_i_update_gpr_wdata : 32'd0);
            $fwrite(brs_trace_fd,
                "stall_mask=0x%01h redirect=%0d redirect_target=0x%08h ",
                cpu_i._scu_i_sc_out_stall,
                cpu_i._pfu_i_if2pf_fetch_addr_update,
                cpu_i._pfu_i_if2pf_fetch_addr_bits);
            $fwrite(brs_trace_fd, "done=%0d done_value=%0d\n",
                brs_done_now, brs_done_now ? dbus_out_wdata : 32'd0);
            $fflush(brs_trace_fd);
        end
    end
