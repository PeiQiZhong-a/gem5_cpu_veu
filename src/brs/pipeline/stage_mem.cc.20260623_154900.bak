#include "brs/pipeline/pipeline_core.hh"

namespace gem5
{

void
PipelineCore::stageMEM()
{
    memwb_next = {};


    if (!exmem_cur.valid) {
        return;
    }

    memwb_next.valid = true;
    memwb_next.pc = exmem_cur.pc;
    memwb_next.kind = exmem_cur.kind;
    memwb_next.rd = exmem_cur.rd;
    memwb_next.reg_write = exmem_cur.reg_write;
    memwb_next.wb_sel = exmem_cur.wb_sel;
    memwb_next.alu_result = exmem_cur.alu_result;
    memwb_next.instr = exmem_cur.instr;

    switch (exmem_cur.kind) {
      case InstrKind::LB:
      {
        const uint8_t v = dataMem.load8(exmem_cur.alu_result);
        memwb_next.mem_data = static_cast<uint32_t>(
            static_cast<int32_t>(static_cast<int8_t>(v)));
        break;
      }
      case InstrKind::LBU:
      {
        const uint8_t v = dataMem.load8(exmem_cur.alu_result);
        memwb_next.mem_data = static_cast<uint32_t>(v);
        break;
      }
      case InstrKind::LH:
      {
        const uint16_t v = dataMem.load16(exmem_cur.alu_result);
        memwb_next.mem_data = static_cast<uint32_t>(
            static_cast<int32_t>(static_cast<int16_t>(v)));
        break;
      }
      case InstrKind::LHU:
      {
        const uint16_t v = dataMem.load16(exmem_cur.alu_result);
        memwb_next.mem_data = static_cast<uint32_t>(v);
        break;
      }
      case InstrKind::LW:
        memwb_next.mem_data = dataMem.load32(exmem_cur.alu_result);
        break;

      case InstrKind::SB:
      {
          const uint32_t store_val =
              static_cast<uint8_t>(exmem_cur.store_data & 0xFF);
          dataMem.store8(exmem_cur.alu_result,
                        static_cast<uint8_t>(store_val));
          traceStore(exmem_cur.pc, exmem_cur.instr,
                    exmem_cur.alu_result, store_val);
          break;
      }
      case InstrKind::SH:
      {
          const uint32_t store_val =
              static_cast<uint16_t>(exmem_cur.store_data & 0xFFFF);
          dataMem.store16(exmem_cur.alu_result,
                          static_cast<uint16_t>(store_val));
          traceStore(exmem_cur.pc, exmem_cur.instr,
                    exmem_cur.alu_result, store_val);
          break;
      }
      case InstrKind::SW:
      {
          const uint32_t store_val = exmem_cur.store_data;
          dataMem.store32(exmem_cur.alu_result, store_val);
          traceStore(exmem_cur.pc, exmem_cur.instr,
                    exmem_cur.alu_result, store_val);
          break;
      }

      default:
        break;
    }
}

} // namespace gem5