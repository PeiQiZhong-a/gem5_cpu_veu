#ifndef __BRS_PROGRAM_IMAGE_HH__
#define __BRS_PROGRAM_IMAGE_HH__

#pragma once

#include <algorithm>
#include <cctype>
#include <cstdint>
#include <fstream>
#include <sstream>
#include <string>
#include <iterator>
#include <vector>

namespace gem5
{

static constexpr uint32_t kProgramWords = 16;

struct ProgramImage
{
  //workload
    uint32_t instr_mem[kProgramWords] = {};
    uint32_t program_words = 0;

    void clear()
    {
        std::fill(std::begin(instr_mem), std::end(instr_mem), 0);
        program_words = 0;
    }

    bool loadHexFile(const std::string &path)
    {
        clear();

        std::ifstream fin(path);
        if (!fin.is_open()) {
            return false;
        }

        std::string line;
        while (std::getline(fin, line)) {
            auto pos = line.find('#');
            if (pos != std::string::npos) {
                line = line.substr(0, pos);
            }

            // 去掉空白
            line.erase(
                std::remove_if(line.begin(), line.end(),
                    [](unsigned char c){ return std::isspace(c); }),
                line.end());

            if (line.empty()) {
                continue;
            }

            if (program_words >= kProgramWords) {
                return false;
            }

            instr_mem[program_words++] =
                static_cast<uint32_t>(std::stoul(line, nullptr, 16));
        }

        return program_words > 0;
    }

    void loadAddiTest()
    {     
        // addi x1, x0, 5
        instr_mem[0] = 0x00500093;

        // addi x2, x0, 7
        instr_mem[1] = 0x00700113;

        // add x3, x1, x2
        instr_mem[2] = 0x002081B3;
        program_words = 3;


    }
    void loadLwTest()
    {
         //addi x1, x0, 0
        instr_mem[0] = 0x00000093;

        //lw x3, 0(x1)
        instr_mem[1] = 0x0000A183;
        program_words = 2;    
    }

    void loadStallTest()
    {
        // addi x1, x0, 0
        instr_mem[0] = 0x00000093;

        // addi x2, x0, 7
        instr_mem[1] = 0x00700113;

        // lw x3, 0(x1)
        instr_mem[2] = 0x0000A183;

        // add x4, x3, x2
        instr_mem[3] = 0x00218233;
        program_words = 4;

    }

    void loadBeqFlushTakenTest()
    {
        // addi x1, x0, 5
        instr_mem[0] = 0x00500093;

        // addi x2, x0, 5
        instr_mem[1] = 0x00500113;

        // beq x1, x2, +8
        instr_mem[2] = 0x00208463;

        // addi x3, x0, 1   // 这条应该被 flush 掉
        instr_mem[3] = 0x00100193;

        // addi x4, x0, 9   // branch target
        instr_mem[4] = 0x00900213;
        program_words = 5;
    }

    void loadBeqNotTakenTest()
    {
        // addi x1, x0, 5
        instr_mem[0] = 0x00500093;

        // addi x2, x0, 7
        instr_mem[1] = 0x00700113;

        // beq x1, x2, +8
        instr_mem[2] = 0x00208463;

        // addi x3, x0, 1   // 不应被 flush
        instr_mem[3] = 0x00100193;

        // addi x4, x0, 9
        instr_mem[4] = 0x00900213;
        program_words = 5;
    }

    void loadJalTest()
    {
        // addi x1, x0, 1
        instr_mem[0] = 0x00100093;

        // jal x4, +8
        instr_mem[1] = 0x0080026F;

        // addi x2, x0, 9   // flush
        instr_mem[2] = 0x00900113;

        // addi x3, x0, 7   // jump target
        instr_mem[3] = 0x00700193;
        program_words = 4;
    }

 
    void loadLuiBasicTest()
    {
        instr_mem[0] = 0x123450B7; // lui x1, 0x12345
        program_words = 1;
    }

    void loadAuipcBasicTest()
    {
        instr_mem[0] = 0x00000097; // auipc x1, 0
        instr_mem[1] = 0x00000117; // auipc x2, 0
        instr_mem[2] = 0x401101B3; // sub x3, x2, x1
        program_words = 3;
    }

    void loadOriBasicTest()
    {
        instr_mem[0] = 0x0F000093; // addi x1, x0, 0x0f0
        instr_mem[1] = 0x00F0E113; // ori  x2, x1, 0x00f
        program_words = 2;
    }

    void loadAndiBasicTest()
    {
        instr_mem[0] = 0x0FF00093; // addi x1, x0, 0x0ff
        instr_mem[1] = 0x00F0F113; // andi x2, x1, 0x00f
        program_words = 2;
    }

    void loadXoriBasicTest()
    {
        instr_mem[0] = 0x0F000093; // addi x1, x0, 0x0f0
        instr_mem[1] = 0x0FF0C113; // xori x2, x1, 0x0ff
        program_words = 2;
    }

    void loadSltiBasicTest()
    {
        instr_mem[0] = 0x00500093; // addi x1, x0, 5
        instr_mem[1] = 0x00A0A113; // slti x2, x1, 10
        program_words = 2;
    }

    void loadSltiuBasicTest()
    {
        instr_mem[0] = 0x00000093; // addi x1, x0, 0
        instr_mem[1] = 0x0010B113; // sltiu x2, x1, 1
        program_words = 2;
    }

    void loadOrBasicTest()
    {
        instr_mem[0] = 0x0F000093; // addi x1, x0, 0x0f0
        instr_mem[1] = 0x00F00113; // addi x2, x0, 0x00f
        instr_mem[2] = 0x0020E1B3; // or   x3, x1, x2
        program_words = 2;
    }

    void loadAndBasicTest()
    {
        instr_mem[0] = 0x0F000093; // addi x1, x0, 0x0f0
        instr_mem[1] = 0x03C00113; // addi x2, x0, 0x03c
        instr_mem[2] = 0x0020F1B3; // and  x3, x1, x2
        program_words = 2;
    }

    void loadXorBasicTest()
    {
        instr_mem[0] = 0x0AA00093; // addi x1, x0, 0x0aa
        instr_mem[1] = 0x0CC00113; // addi x2, x0, 0x0cc
        instr_mem[2] = 0x0020C1B3; // xor  x3, x1, x2
        program_words = 2;
    }

    void loadSltBasicTest()
    {
        instr_mem[0] = 0xFFF00093; // addi x1, x0, -1
        instr_mem[1] = 0x00100113; // addi x2, x0, 1
        instr_mem[2] = 0x0020A1B3; // slt  x3, x1, x2
        program_words = 2;
    }

    void loadSltuBasicTest()
    {
        instr_mem[0] = 0xFFF00093; // addi x1, x0, -1
        instr_mem[1] = 0x00100113; // addi x2, x0, 1
        instr_mem[2] = 0x0020B1B3; // sltu x3, x1, x2
        program_words = 2;
    }





};

struct DataImage
{
    std::vector<uint8_t> data;

    void clear()
    {
        data.clear();
    }

    bool loadHexFile(const std::string &path, const std::string &format)
    {
        clear();

        std::ifstream fin(path);
        if (!fin.is_open()) {
            return false;
        }

        // --- collect all tokens in a first pass ---
        std::vector<std::string> tokens;
        std::string line;
        while (std::getline(fin, line)) {
            // strip comments
            auto pos = line.find('#');
            if (pos != std::string::npos)
                line = line.substr(0, pos);
            pos = line.find("//");
            if (pos != std::string::npos)
                line = line.substr(0, pos);

            std::istringstream iss(line);
            std::string token;
            while (iss >> token) {
                token.erase(
                    std::remove_if(token.begin(), token.end(),
                                   [](unsigned char c){ return c == '_'; }),
                    token.end());
                if (!token.empty()) {
                    tokens.push_back(token);
                }
            }
        }

        if (tokens.empty()) {
            return false;
        }

        // --- detect format (auto / byte / word) ---
        bool isWordFormat;
        if (format == "word") {
            isWordFormat = true;
        } else if (format == "byte") {
            isWordFormat = false;
        } else { // auto
            isWordFormat = false;
            for (const auto &t : tokens) {
                std::string lower = t;
                std::transform(lower.begin(), lower.end(), lower.begin(),
                               [](unsigned char c){ return std::tolower(c); });
                size_t hpos = (lower.size() >= 2 && lower[0] == '0' && lower[1] == 'x')
                                  ? 2 : 0;
                if (lower.size() - hpos > 2) {
                    isWordFormat = true;
                    break;
                }
            }
        }

        // --- parse tokens into byte array ---
        for (const auto &token : tokens) {
            uint64_t value = std::stoul(token, nullptr, 16);
            if (isWordFormat) {
                if (value > 0xffffffffULL) {
                    return false;
                }
                data.push_back(static_cast<uint8_t>(value & 0xff));
                data.push_back(static_cast<uint8_t>((value >> 8) & 0xff));
                data.push_back(static_cast<uint8_t>((value >> 16) & 0xff));
                data.push_back(static_cast<uint8_t>((value >> 24) & 0xff));
            } else {
                if (value > 0xffULL) {
                    return false;
                }
                data.push_back(static_cast<uint8_t>(value));
            }
        }

        return !data.empty();
    }
};

} // namespace gem5

#endif
