#include "brs/pipeline/pipeline_core.hh"

namespace gem5
{

static bool
isLoadInstr(InstrKind kind)
{
    return kind == InstrKind::LB || kind == InstrKind::LBU ||
           kind == InstrKind::LH || kind == InstrKind::LHU ||
           kind == InstrKind::LW;
}

static bool
isStoreInstr(InstrKind kind)
{
    return kind == InstrKind::SB || kind == InstrKind::SH ||
           kind == InstrKind::SW;
}

static unsigned
memAccessSize(InstrKind kind)
{
    switch (kind) {
      case InstrKind::LB:
      case InstrKind::LBU:
      case InstrKind::SB:
        return 1;
      case InstrKind::LH:
      case InstrKind::LHU:
      case InstrKind::SH:
        return 2;
      case InstrKind::LW:
      case InstrKind::SW:
        return 4;
      default:
        return 0;
    }
}

static uint32_t
signOrZeroExtendLoad(InstrKind kind, uint32_t value)
{
    switch (kind) {
      case InstrKind::LB:
        return static_cast<uint32_t>(
            static_cast<int32_t>(static_cast<int8_t>(value & 0xff)));
      case InstrKind::LBU:
        return value & 0xff;
      case InstrKind::LH:
        return static_cast<uint32_t>(
            static_cast<int32_t>(static_cast<int16_t>(value & 0xffff)));
      case InstrKind::LHU:
        return value & 0xffff;
      case InstrKind::LW:
      default:
        return value;
    }
}

void
PipelineCore::stageMEM()
{
    memwb_next = {};


    if (!exmem_cur.valid) {
        return;
    }

    const bool isLoad = isLoadInstr(exmem_cur.kind);
    const bool isStore = isStoreInstr(exmem_cur.kind);

    if (isLoad || isStore) {
        const unsigned size = memAccessSize(exmem_cur.kind);
        panic_if(!requestTimingData,
                 "Timing data backend is not configured for memory access");

        if (!mem_req_issued && !data_waiting && !data_response_valid) {
            const bool accepted = requestTimingData(
                exmem_cur.alu_result, size, isStore, exmem_cur.store_data);
            if (accepted) {
                mem_req_issued = true;
                data_waiting = true;
            }
            mem_stall = true;
            ++stall_count;
            return;
        }

        if (!data_response_valid) {
            mem_stall = true;
            ++stall_count;
            return;
        }

        panic_if(data_response_addr != exmem_cur.alu_result,
                 "Data response address mismatch: response=%#x expected=%#x",
                 data_response_addr, exmem_cur.alu_result);
        panic_if(data_response_is_store != isStore,
                 "Data response type mismatch for pc=%#x", exmem_cur.pc);
    }

    memwb_next.valid = true;
    memwb_next.pc = exmem_cur.pc;
    memwb_next.kind = exmem_cur.kind;
    memwb_next.rd = exmem_cur.rd;
    memwb_next.reg_write = exmem_cur.reg_write;
    memwb_next.wb_sel = exmem_cur.wb_sel;
    memwb_next.alu_result = exmem_cur.alu_result;
    memwb_next.instr = exmem_cur.instr;

    if (isLoad) {
        memwb_next.mem_data = signOrZeroExtendLoad(
            exmem_cur.kind, data_response_value);
    } else if (isStore) {
        const uint32_t store_val = (exmem_cur.kind == InstrKind::SB) ?
            (exmem_cur.store_data & 0xff) :
            ((exmem_cur.kind == InstrKind::SH) ?
                (exmem_cur.store_data & 0xffff) : exmem_cur.store_data);
        traceStore(exmem_cur.pc, exmem_cur.instr,
                   exmem_cur.alu_result, store_val);
    }

    if (isLoad || isStore) {
        mem_req_issued = false;
        data_waiting = false;
        data_response_valid = false;
        data_response_addr = 0;
        data_response_value = 0;
        data_response_is_store = false;
    }
}

} // namespace gem5
